    ]
  },
  {
    "id": "dashboard-telemetry-format",
    "type": "function",
    "z": "robot-tab",
    "name": "Format dashboard telemetry",
    "func": "let payload = msg.payload;\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch (err) { payload = null; }\n}\nconst value = payload && Number(payload.value);\nconst valid = payload && payload.valid === true && payload.unit === 'cm' &&\n    typeof payload.value === 'number' && Number.isFinite(value) && value >= 2 && value <= 200;\nconst text = valid ? `Distancia: ${value} cm` :\n    `Sensor no disponible: ${(payload && payload.reason) || 'medición inválida'}`;\nconst indicator = valid ? {\n    distance: value,\n    percent: value / 2,\n    level: value < 20 ? 'danger' : value <= 50 ? 'caution' : 'safe',\n    label: value < 20 ? 'Muy cerca' : value <= 50 ? 'Precaución' : 'Distancia segura',\n    receivedAt: payload.receivedAt || new Date().toISOString()\n} : { level: 'unavailable', label: 'Sensor no disponible' };\nreturn [{ ...msg, payload: text }, { ...msg, payload: indicator }];",
    "outputs": 2,
