  {
    "id": "robot-html-template",
    "type": "template",
    "z": "robot-tab",
    "name": "Robot GUI HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Robot MQTT</title>\n  <style>\n    body { font-family: system-ui, sans-serif; background: #111827; color: #f9fafb; margin: 0; padding: 24px; }\n    main { max-width: 720px; margin: auto; }\n    .card { background: #1f2937; border-radius: 16px; padding: 20px; margin-bottom: 16px; box-shadow: 0 10px 30px #0004; }\n    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }\n    button { border: 0; border-radius: 12px; padding: 18px; font-size: 18px; font-weight: 700; cursor: pointer; background: #2563eb; color: white; }\n    button:hover { filter: brightness(1.1); }\n    .stop { background: #dc2626; }\n    .auto { background: #16a34a; }\n    .muted { color: #9ca3af; }\n    input { width: 100%; }\n    pre { background: #030712; padding: 12px; border-radius: 12px; overflow-x: auto; }\n  </style>\n</head>\n<body>\n<main>\n  <h1>Robot MQTT</h1>\n  <p class=\"muted\">Node-RED → Mosquitto → ESP32 → L298N → motores</p>\n\n  <section class=\"card\">\n    <label for=\"speed\">Velocidad PWM: <strong id=\"speedValue\">180</strong></label>\n    <input id=\"speed\" type=\"range\" min=\"0\" max=\"255\" value=\"180\">\n  </section>\n\n  <section class=\"card grid\">\n    <span></span>\n    <button onclick=\"sendCommand('FORWARD')\">▲ FORWARD</button>\n    <span></span>\n    <button onclick=\"sendCommand('CCW')\">↺ CCW</button>\n    <button class=\"stop\" onclick=\"sendCommand('STOP')\">■ STOP</button>\n    <button onclick=\"sendCommand('CW')\">↻ CW</button>\n    <span></span>\n    <button onclick=\"sendCommand('BACKWARD')\">▼ BACKWARD</button>\n    <span></span>\n  </section>\n\n  <section class=\"card\">\n    <button class=\"auto\" onclick=\"sendCommand('RECTANGLE')\">Iniciar rutina rectangular</button>\n  </section>\n\n  <section class=\"card\">\n    <h2>Respuesta del robot</h2>\n    <pre id=\"response\">Esperando respuesta...</pre>\n  </section>\n\n  <section class=\"card\">\n    <h2>Distancia ultrasónica</h2>\n    <p id=\"distance\">Esperando telemetría...</p>\n    <pre id=\"telemetry\"></pre>\n  </section>\n</main>\n<script>\nconst speed = document.getElementById('speed');\nconst speedValue = document.getElementById('speedValue');\nspeed.addEventListener('input', () => speedValue.textContent = speed.value);\n\nasync function sendCommand(command) {\n  const response = await fetch('/api/cmd', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ command, speed: Number(speed.value) })\n  });\n  const data = await response.json();\n  document.getElementById('response').textContent = JSON.stringify(data, null, 2);\n}\n\nasync function refreshStatus() {\n  try {\n    const response = await fetch('/api/status');\n    const data = await response.json();\n    document.getElementById('response').textContent = JSON.stringify(data.response, null, 2);\n    const telemetry = data.telemetry;\n    document.getElementById('telemetry').textContent = JSON.stringify(telemetry, null, 2);\n    document.getElementById('distance').textContent = telemetry && telemetry.valid\n      ? `${telemetry.value} ${telemetry.unit || 'cm'}`\n      : `Sensor no disponible: ${(telemetry && telemetry.reason) || 'sin medición'}`;\n  } catch (err) {\n    document.getElementById('response').textContent = err.message;\n  }\n}\n\nsetInterval(refreshStatus, 1000);\nrefreshStatus();\n</script>\n</body>\n</html>",
    "output": "str",
