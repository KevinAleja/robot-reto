  {
    "id": "dashboard-build-command",
    "type": "function",
    "z": "robot-tab",
    "name": "Dashboard command to MQTT",
    "func": "const command = String(msg.payload || '').toUpperCase();\nconst speed = Math.max(0, Math.min(255, Number(flow.get('dashboardSpeed')) || 180));\nflow.set('lastCommand', { command, speed, sentAt: new Date().toISOString(), source: 'dashboard' });\nmsg.topic = 'robot/command';\nmsg.payload = JSON.stringify({ command, speed });\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 700,
    "wires": [
