    "id": "store-status",
    "type": "function",
    "z": "robot-tab",
    "name": "Store response",
    "func": "let payload = msg.payload;\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch (err) { node.warn('Ignored invalid MQTT response'); return null; }\n}\nif (!payload || typeof payload !== 'object' || Array.isArray(payload)) {\n    node.warn('Ignored invalid MQTT response');\n    return null;\n}\npayload.receivedAt = new Date().toISOString();\nflow.set('lastResponse', payload);\nreturn msg;",
