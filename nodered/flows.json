  {
    "id": "build-command",
    "type": "function",
    "z": "robot-tab",
    "name": "Validate and publish command",
    "func": "const allowed = ['FORWARD', 'BACKWARD', 'CW', 'CCW', 'STOP', 'RECTANGLE'];\nconst body = msg.payload || {};\nconst command = String(body.command || '').toUpperCase();\nconst speed = Number.isFinite(Number(body.speed)) ? Math.max(0, Math.min(255, Number(body.speed))) : 180;\n\nif (!allowed.includes(command)) {\n    msg.statusCode = 400;\n    msg.payload = { ok: false, error: 'Invalid command', allowed };\n    return [null, msg];\n}\n\nconst mqttMsg = {\n    topic: 'robot/command',\n    payload: JSON.stringify({ command, speed })\n};\n\nflow.set('lastCommand', { command, speed, sentAt: new Date().toISOString() });\nmsg.payload = { ok: true, sent: { command, speed } };\nreturn [mqttMsg, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 180,
    "wires": [
      [
        "mqtt-out-command"
      ],
      [
        "http-response-cmd"
      ]
    ]
  },
