  {
    "id": "robot-ui-distance-indicator",
    "type": "ui_template",
    "z": "robot-tab",
    "group": "robot-ui-status-group",
    "name": "Indicador de distancia",
    "order": 3,
    "width": 6,
    "height": 3,
    "format": "<style>\n.robot-distance { padding: 8px 0; font-size: 16px; }\n.robot-distance .reading { font-size: 24px; font-weight: 700; }\n.robot-distance .track { height: 22px; border-radius: 12px; background: #ddd; overflow: hidden; margin: 10px 0; }\n.robot-distance .fill { height: 100%; transition: width .25s ease, background-color .25s ease; }\n.robot-distance .danger { color: #b91c1c; }\n.robot-distance .caution { color: #92400e; }\n.robot-distance .safe { color: #166534; }\n.robot-distance .unavailable { color: #52525b; }\n</style>\n<div class=\"robot-distance\" ng-class=\"display.level\" aria-live=\"polite\">\n  <div class=\"reading\">{{display.distance === null ? '—' : (display.distance + ' cm')}}</div>\n  <div class=\"track\" role=\"progressbar\" aria-label=\"Distancia ultrasónica\" aria-valuemin=\"0\" aria-valuemax=\"200\" aria-valuenow=\"{{display.distance === null ? '' : display.distance}}\">\n    <div class=\"fill\" ng-style=\"{'width': (display.percent || 0) + '%', 'background-color': display.level === 'danger' ? '#dc2626' : display.level === 'caution' ? '#d97706' : display.level === 'safe' ? '#16a34a' : '#a1a1aa'}\"></div>\n  </div>\n  <strong>{{display.label}}</strong>\n</div>\n<script>\n(function(scope) {\n  scope.display = { distance: null, percent: 0, level: 'unavailable', label: 'Esperando telemetría' };\n  function update() {\n    var reading = scope.msg && scope.msg.payload;\n    var timestamp = reading && Date.parse(reading.receivedAt);\n    if (!reading || reading.level === 'unavailable') {\n      scope.display = { distance: null, percent: 0, level: 'unavailable', label: reading ? reading.label : 'Esperando telemetría' };\n    } else if (!Number.isFinite(timestamp) || Date.now() - timestamp > 5000 || timestamp > Date.now() + 5000) {\n      scope.display = { distance: null, percent: 0, level: 'unavailable', label: 'Telemetría desactualizada' };\n    } else {\n      scope.display = reading;\n    }\n  }\n  scope.$watch('msg', update);\n  var timer = setInterval(function() { scope.$applyAsync(update); }, 1000);\n  scope.$on('$destroy', function() { clearInterval(timer); });\n})(scope);\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 650,
    "y": 650,
    "wires": [
