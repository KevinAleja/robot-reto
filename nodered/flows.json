    "func": "let payload = msg.payload;\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch (err) { payload = { raw: msg.payload }; }\n}\nmsg.payload = `${payload.ok === false ? 'ERROR' : 'OK'} | ${payload.state || 'UNKNOWN'} | ${payload.detail || ''}`;\nreturn msg;",
